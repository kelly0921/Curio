# Optional in local development: Curio derives the LAN host from Metro and uses port 3031.
# Set this when auto-detection is not possible or for an EAS preview/production build.
EXPO_PUBLIC_CURIO_API_URL=https://your-curio-api.example.com
# Legacy personal-beta access gate. Remove after Better Auth is configured.
EXPO_PUBLIC_CURIO_API_TOKEN=

# Enables the Google sign-in gate after the processor's Better Auth secrets and
# Google callback are configured. No OAuth secret belongs in the client.
EXPO_PUBLIC_CURIO_AUTH_ENABLED=false

# Optional in local development: Curio derives the LAN host from Metro and uses port 3031.
# Set this when auto-detection is not possible or for an EAS preview/production build.
EXPO_PUBLIC_CURIO_API_URL=https://your-curio-api.example.com
# Legacy personal-beta access gate. Remove after Supabase Auth is configured.
EXPO_PUBLIC_CURIO_API_TOKEN=

# Passwordless private-beta sign-in. Publishable keys are designed for clients;
# never place a Supabase secret/service-role key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

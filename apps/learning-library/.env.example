# Required for real transcription and Learning Card generation.
OPENAI_API_KEY=

# Optional model overrides. Defaults are documented in README.md.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_RETRIEVAL_MODEL=gpt-5.4-mini
# Opt in to comparing a new card with candidate resource text through OpenAI.
# RESOURCE_MERGE_AI_ENABLED=true
# ENABLE_EXPERIMENTAL_INSTAGRAM_EMBED=true

# Required outside local development. Generate a long random value and keep it outside Git.
# Legacy personal-beta fallback; remove it after Supabase Auth is enabled.
CURIO_API_TOKEN=
# Optional comma-separated browser origins. Native mobile requests do not require CORS.
CURIO_ALLOWED_ORIGINS=

# Optional durable persistence. Set both or neither.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Passwordless private-beta authentication. When both values are set, verified
# Supabase user sessions replace the shared personal-beta token.
SUPABASE_AUTH_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional comma-separated beta allowlist; store this as a Worker secret.
CURIO_INVITED_EMAILS=
# Optional migration bridge: this verified user keeps the existing personal-beta library.
CURIO_LEGACY_OWNER_EMAIL=

# Legacy Supabase fallback; prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=
